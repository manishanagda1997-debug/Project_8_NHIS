    ax.set_title(title)
    ax.set_xlabel(f"{unit} (log scale)")
    ax.set_ylabel("jobs")
fig.suptitle("Pay distributions (shaded band = middle half of jobs, IQR)", fontweight="bold", y=1.03)
fig.tight_layout()
plt.show()





